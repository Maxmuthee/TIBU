# Gemini (LLM + embeddings)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.0-flash-lite

# OpenRouteService — walking directions on the Campus Navigator map
# Free key: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key-here

# Supabase — Study Hub past-paper storage (files) + metadata table
# Project Settings → API. Use the SERVICE ROLE key (keep server-side only).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=past-papers

# PostgreSQL / Supabase (pgvector)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
